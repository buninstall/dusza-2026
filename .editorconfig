root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.rs]
indent_size = 4

[*.ms]
indent_style = space
indent_size = 4
trim_trailing_whitespace = false
insert_final_newline = false

[conformance/**.txt]
trim_trailing_whitespace = false
insert_final_newline = false

[justfile]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
