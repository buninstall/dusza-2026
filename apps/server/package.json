{
  "name": "@minescript/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts --no-open",
    "start": "bun src/index.ts --static --no-open",
    "start:test": "bun src/index.ts --test-mode --no-open --port 8090",
    "db:generate": "drizzle-kit generate",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@minescript/engine": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
