[Unit]
Description=MineScript (Bun + WASM motor)
Documentation=file:///srv/minescript/repo/docs/telepites.md
After=network-online.target mysql.service
Wants=network-online.target mysql.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=minescript
Group=minescript
EnvironmentFile=/etc/minescript/minescript.env
Environment=HOME=/var/lib/minescript
WorkingDirectory=/var/lib/minescript
ExecStart=/srv/minescript/current/minescript --no-open
Restart=always
RestartSec=2
TimeoutStopSec=20
KillSignal=SIGTERM
StateDirectory=minescript
StateDirectoryMode=0700
UMask=0077
LimitNOFILE=65536
MemoryMax=1G
TasksMax=512
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
