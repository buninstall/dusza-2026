{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MineScript Desktop",
  "mainBinaryName": "MineScript Desktop",
  "version": "0.1.0",
  "identifier": "hu.dusza.csapat13.minescript",
  "build": {
    "frontendDist": "pages"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https: http:"
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "MineScript Desktop",
    "longDescription": "Programozd a kincskereső robotot MineScript nyelven a bányatérképen.",
    "copyright": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 660,
          "height": 458
        },
        "appPosition": {
          "x": 170,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 490,
          "y": 190
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5QjcwNTEyMDM3NTQyNDgKUldSSVFuVURFZ1czNmZmSHZCSEl3UmVuWHRPVVJQUEdKZXZ1TDA1K1Fmcm02YlJlZGYwZ3Fsd2YK",
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
